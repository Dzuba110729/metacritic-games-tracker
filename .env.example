# Ключ Claude API. Заполняй только в .env на сервере, в git не коммить.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_BUDGET_USD=3
TZ=Europe/Moscow
DATABASE_URL=sqlite:///data/games.db
SCHEDULE_MINUTES=60
FORCE_RUN_COOLDOWN_MIN=10
LOG_LEVEL=INFO
# Публичный ключ фронтенда metacritic.com. Значение по умолчанию — в app/config.py;
# задавать, только если сайт его сменит.
# METACRITIC_API_KEY=
